{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "api-gateway (Local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build api-gateway",
      "program": "${workspaceFolder}/api-gateway/src/WebApi/bin/Debug/net10.0/WebApi.dll",
      "cwd": "${workspaceFolder}/api-gateway/src/WebApi",
      "launchSettingsFilePath": "${workspaceFolder}/api-gateway/src/WebApi/Properties/launchSettings.json",
      "launchSettingsProfile": "http"
    },
    {
      "name": "ms-auth (Local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ms-auth",
      "program": "${workspaceFolder}/services/ms-auth/src/WebApi/bin/Debug/net10.0/WebApi.dll",
      "cwd": "${workspaceFolder}/services/ms-auth/src/WebApi",
      "launchSettingsFilePath": "${workspaceFolder}/services/ms-auth/src/WebApi/Properties/launchSettings.json",
      "launchSettingsProfile": "http"
    }
  ],
  "compounds": [
    {
      "name": "All services (Local)",
      "configurations": [
        "api-gateway (Local)",
        "ms-auth (Local)"
      ],
      "stopAll": true
    }
  ]
}
