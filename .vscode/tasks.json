{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build ms-auth",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/services/ms-auth/src/WebApi/WebApi.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build api-gateway",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/api-gateway/src/WebApi/WebApi.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build ms-listing",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/services/ms-listing/src/WebApi/WebApi.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
