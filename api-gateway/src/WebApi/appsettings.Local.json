{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "listing-images": {
        "Match": {
          "Path": "/listing-images-dev/{**rest}"
        }
      }
    },
    "Clusters": {
      "ms-auth": {
        "Destinations": {
          "main": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "ms-listing": {
        "Destinations": {
          "main": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "minio": {
        "Destinations": {
          "main": {
            "Address": "http://localhost:9000"
          }
        }
      }
    }
  }
}
