{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 600
    },
    "Seller": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Api": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "ms-auth",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version}/Auth/{**rest}"
        }
      },
      "auth-login": {
        "ClusterId": "ms-auth",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/v{version}/Auth/Login"
        }
      },
      "auth-register": {
        "ClusterId": "ms-auth",
        "RateLimiterPolicy": "register",
        "Match": {
          "Path": "/api/v{version}/Auth/Register"
        }
      },
      "auth-sellers": {
        "ClusterId": "ms-auth",
        "RateLimiterPolicy": "seller",
        "Match": {
          "Path": "/api/v{version}/Auth/Sellers/{**rest}"
        }
      },
      "brand": {
        "ClusterId": "ms-listing",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version}/Brand/{**rest}"
        }
      },
      "model": {
        "ClusterId": "ms-listing",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version}/Model/{**rest}"
        }
      },
      "city": {
        "ClusterId": "ms-listing",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version}/City/{**rest}"
        }
      },
      "listing": {
        "ClusterId": "ms-listing",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version}/Listing/{**rest}"
        }
      },
      "listing-image": {
        "ClusterId": "ms-listing",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version}/ListingImage/{**rest}"
        }
      },
      "listing-images": {
        "ClusterId": "minio",
        "Match": {
          "Path": "/listing-images/{**rest}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "web": {
        "ClusterId": "web",
        "Match": {
          "Path": "/{**rest}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      }
    },
    "Clusters": {
      "ms-auth": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "main": {
            "Address": "http://ms-auth:8080"
          }
        }
      },
      "ms-listing": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "main": {
            "Address": "http://ms-listing:8080"
          }
        }
      },
      "minio": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "main": {
            "Address": "http://minio:9000"
          }
        }
      },
      "web": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "main": {
            "Address": "http://web:8080"
          }
        }
      }
    }
  }
}
