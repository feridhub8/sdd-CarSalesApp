{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "BaseUrl": "http://keycloak:8080",
    "Realm": "carsales",
    "ClientId": "ms-listing",
    "RequireHttpsMetadata": false
  },
  "Vault": {
    "Address": "http://vault:8200",
    "Mount": "carsales",
    "SecretPath": "ms-listing"
  },
  "Storage": {
    "Endpoint": "http://minio:9000",
    "Bucket": "listing-images"
  },
  "ExchangeRates": {
    "SourceUrl": "https://www.cbar.az/currencies/{0}.xml",
    "RefreshHours": 6,
    "Fallback": {
      "Usd": 1.7,
      "Eur": 1.9
    }
  }
}
