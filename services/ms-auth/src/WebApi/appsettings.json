{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "BaseUrl": "http://keycloak:8080",
    "Realm": "carsales",
    "ClientId": "ms-auth",
    "RequireHttpsMetadata": false
  },
  "Vault": {
    "Address": "http://vault:8200",
    "Mount": "carsales",
    "SecretPath": "ms-auth"
  }
}
